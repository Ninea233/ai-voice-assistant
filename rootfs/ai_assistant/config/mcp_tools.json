[
    {
        "name": "get_weather",
        "description": "获取指定城市的实时天气信息和未来天气预报。返回当前温度、湿度、风力、天气状况以及未来3天天气预报",
        "inputSchema": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string",
                    "description": "城市名称，如'杭州'、'北京'、'上海'；支持英文城市名如'New York'",
                    "default": "杭州"
                }
            }
        },
        "_implementation": {
            "type": "builtin",
            "handler": "get_weather"
        }
    },
    {
        "name": "get_time",
        "description": "获取当前北京时间或指定时区的时间。读取系统本地时间，支持时区转换",
        "inputSchema": {
            "type": "object",
            "properties": {
                "timezone": {
                    "type": "string",
                    "description": "IANA 时区名称，如'Asia/Shanghai'（北京时间）、'America/New_York'（纽约时间）",
                    "default": "Asia/Shanghai"
                }
            }
        },
        "_implementation": {
            "type": "builtin",
            "handler": "get_time"
        }
    },
    {
        "name": "get_news",
        "description": "获取今日热点新闻或指定话题的最新资讯。返回新闻标题和摘要列表",
        "inputSchema": {
            "type": "object",
            "properties": {
                "topic": {
                    "type": "string",
                    "description": "新闻话题类别，如'科技'、'体育'、'财经'、'娱乐'、'热点'（默认）",
                    "default": "热点"
                }
            }
        },
        "_implementation": {
            "type": "http",
            "url": "",
            "method": "GET"
        }
    }
]
