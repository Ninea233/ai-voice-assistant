#===========================================
# enable_wm8960_audio.patch
#
# 用途: 在 Linux 4.1.15 内核中启用 WM8960 + SAI 音频驱动
# 应用方式:
#   cd /home/nine/linux/IMX6ULL/linux/mx6ull_linux
#   patch -p1 < 路径/enable_wm8960_audio.patch
#   或手动 make menuconfig
#===========================================

--- a/.config
+++ b/.config
@@ -2301,10 +2301,12 @@ CONFIG_SND_SOC_IMX_SSI=m
 # CONFIG_SND_SOC_IMX_MC13783 is not set
 CONFIG_SND_SOC_IMX_UTILS=m
 # CONFIG_SND_SOC_IMX_PCM_FIQ is not set
-# CONFIG_SND_SOC_FSL_SAI is not set
+CONFIG_SND_SOC_FSL_SAI=y
+CONFIG_SND_SOC_WM8960=y
+CONFIG_SND_SOC_IMX_WM8960=y
 CONFIG_SND_SOC_IMX_WM8962=m
 # CONFIG_SND_SOC_IMX_SGTL5000 is not set
 # CONFIG_SND_SOC_IMX_SPDIF is not set
diff --git a/arch/arm/boot/dts/imx6ull-alientek-emmc.dts b/arch/arm/boot/dts/imx6ull-alientek-emmc.dts
index XXXXXXX..YYYYYYY 100644
--- a/arch/arm/boot/dts/imx6ull-alientek-emmc.dts
+++ b/arch/arm/boot/dts/imx6ull-alientek-emmc.dts
@@ -2,3 +2,4 @@
  * DTS 无需修改，WM8960 + SAI2 已配置完成
  * 只需确保内核驱动已编译即可
+ * 检查 sound 节点 compatible = "fsl,imx6ul-evk-wm8960"
